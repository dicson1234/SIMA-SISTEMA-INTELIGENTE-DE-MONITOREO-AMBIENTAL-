/* SIMA v2 — Botanical Glass presentation theme */

QMainWindow {
    background: #08110c;
}

QWidget {
    color: #e8f1e7;
    font-family: "Segoe UI", "Inter", "Roboto", sans-serif;
    font-size: 13px;
}

QStatusBar {
    background: rgba(8, 17, 12, 230);
    border-top: 1px solid #263b2a;
    color: #91a691;
    padding: 4px 10px;
}
QStatusBar::item { border: none; }

/* Surfaces */
QFrame#dashboardSurface {
    background-color: #09130d;
    background-image: url(assets/botanical-overlay.svg);
    background-repeat: no-repeat;
    background-position: center;
    border: 1px solid #203324;
    border-radius: 14px;
}

QFrame#dashboardHero,
QFrame#dashboardMetricCard,
QFrame#dashboardGaugesCard,
QFrame#chartsPanel,
QFrame#historyPanel,
QFrame#cardFrame,
QFrame.card {
    background-color: rgba(16, 27, 19, 238);
    border: 1px solid #2a402f;
    border-radius: 14px;
}

QFrame#dashboardHero {
    background-color: rgba(12, 23, 15, 245);
    border-color: #334e39;
}

QFrame#dashboardHero:hover,
QFrame#dashboardMetricCard:hover,
QFrame#dashboardGaugesCard:hover,
QFrame#chartsPanel:hover,
QFrame#historyPanel:hover,
QFrame#cardFrame:hover,
QFrame.card:hover {
    border-color: #55764f;
}

QLabel#dashboardTitle {
    color: #c9e9b1;
    font-size: 17px;
    font-weight: 700;
}
QLabel#dashboardSubtitle {
    color: #8ea18d;
    font-size: 11px;
}
QLabel#dashboardState {
    background: #14261a;
    color: #b5df9b;
    border: 1px solid #35563a;
    border-radius: 16px;
    padding: 7px 12px;
    font-size: 10px;
    font-weight: 700;
}
QLabel#panelTitle {
    color: #c5ddbb;
    letter-spacing: 0.2px;
}

/* Air quality chips */
QFrame#airBanner {
    background-color: rgba(11, 22, 14, 238);
    border: 1px solid #29412f;
    border-radius: 12px;
}
QLabel#airBannerTitle {
    color: #b9d99e;
}
QLabel[airChip="true"] {
    background: #111f15;
    color: #9aac99;
    border: 1px solid #263e2d;
    border-radius: 10px;
    padding: 5px 9px;
}
QLabel#airPhase {
    color: #6e846f;
    font-size: 9px;
    font-weight: 700;
}

/* Inner tabs */
QTabWidget::pane {
    background: rgba(9, 18, 12, 242);
    border: 1px solid #2a402f;
    border-radius: 12px;
    top: -1px;
}
QTabBar::tab {
    background: #0e1a12;
    color: #839486;
    border: 1px solid #233829;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 9px 16px;
    margin-right: 4px;
    font-size: 11px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: #18291b;
    color: #b8dd9f;
    border-top: 3px solid #86a968;
}
QTabBar::tab:hover:!selected {
    background: #142318;
    color: #c8dcc2;
}

/* Buttons */
QPushButton {
    background: #15241a;
    color: #dfeadd;
    border: 1px solid #304833;
    border-radius: 9px;
    padding: 7px 13px;
    font-weight: 600;
}
QPushButton:hover {
    background: #203624;
    border-color: #76a060;
    color: #ffffff;
}
QPushButton:pressed {
    background: #2a4630;
}
QPushButton:disabled {
    background: #0d1710;
    color: #566457;
    border-color: #1d2a20;
}
QPushButton#subtleButton {
    background: #111f15;
    color: #a9bdab;
    border: 1px solid #2b4130;
    padding: 5px 10px;
}
QPushButton#primaryButton {
    background: #617f53;
    border-color: #8eaf79;
    color: #f4faef;
}
QPushButton#dangerButton {
    background: #773e3c;
    border-color: #a15a56;
    color: #fff4f2;
}

/* Form controls */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #0c1710;
    color: #e8f1e7;
    border: 1px solid #2b4030;
    border-radius: 9px;
    padding: 8px 11px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #86a968;
}
QComboBox QAbstractItemView {
    background: #101c13;
    color: #e8f1e7;
    selection-background-color: #304a34;
    selection-color: #ffffff;
    border: 1px solid #38523c;
}

/* Tables */
QTableWidget {
    background: #0a130e;
    color: #dce7dc;
    border: none;
    gridline-color: #1d2c21;
    alternate-background-color: #0d1711;
}
QTableWidget::item {
    padding: 7px;
    border-bottom: 1px solid #18261b;
}
QTableWidget::item:selected {
    background: #28402d;
    color: #eff8ec;
}
QHeaderView::section {
    background: #122017;
    color: #abc3a8;
    padding: 8px;
    font-weight: 700;
    border: none;
    border-bottom: 1px solid #34523a;
}

/* Text areas / logs */
QTextEdit {
    background: #08110c;
    color: #dbe7db;
    border: 1px solid #24372a;
    border-radius: 10px;
    padding: 8px;
    selection-background-color: #345239;
}
QTextEdit#systemLog {
    background: #07100b;
    border-color: #233629;
    color: #cbdacb;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #09110d;
    width: 9px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #2b4130;
    min-height: 28px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: #4e6d50; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { border: none; background: none; }
QScrollBar:horizontal {
    background: #09110d;
    height: 9px;
}
QScrollBar::handle:horizontal {
    background: #2b4130;
    min-width: 28px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover { background: #4e6d50; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { border: none; background: none; }

QToolTip {
    background: #142318;
    color: #e6f0e4;
    border: 1px solid #4b684c;
    border-radius: 8px;
    padding: 6px 9px;
}

QDialog {
    background: #0b140e;
    color: #e7f0e5;
}
QMessageBox {
    background: #0c160f;
}
QMessageBox QLabel { color: #e5eee3; }

QSplitter::handle {
    background: #203225;
    border-radius: 4px;
}
QSplitter::handle:hover { background: #526e4e; }
