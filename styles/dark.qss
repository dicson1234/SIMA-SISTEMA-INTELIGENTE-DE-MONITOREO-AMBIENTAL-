/* ═══════════════════════════════════════════════════════════════════
   SIMA v2.0 — Olive Nature Elegance Theme (Ajuste Fiel a Referencia)
   
   Paleta:
     Base         #141714   Negro verdoso profundo
     Surface      #161916   Panel oscuro profundo
     Surface2     #1e221c   Tarjeta elevada
     Surface3     #252a23   Tarjeta hover / elevación
     Border       #30372c   Borde sutil
     BorderLight  #3a4236   Borde resaltado
     Olive        #6f7e5d   Verde oliva principal
     OliveMid     #82936b   Verde oliva medio
     OliveLight   #a5b98a   Verde claro / estado OK
     Beige        #d8d0be   Beige principal
     Cream        #e8e3d7   Crema claro
     BeigeDark    #bfb7a5   Beige oscuro
     TextPrimary  #f2f0e8   Blanco cálido
     TextSecondary #c8c7be  Gris claro
     TextMuted    #969890   Gris secundario
     Danger       #c45c5c   Rojo discreto
     Warn         #d4a94e   Amarillo suave
   ═══════════════════════════════════════════════════════════════════ */

/* ─── Base Global ─── */
QMainWindow {
    background: #141714;
}
QWidget {
    color: #f2f0e8;
    font-family: "Segoe UI", "Inter", "SF Pro Display", "Roboto", sans-serif;
    font-size: 13px;
}

/* ─── Status Bar ─── */
QStatusBar {
    background: #111411;
    border-top: 1px solid #30372c;
    color: #969890;
    padding: 5px 14px;
    font-size: 11px;
}
QStatusBar::item { border: none; }

/* ─── Dashboard Surface ─── */
QWidget#dashboardSurface {
    background-color: #141714;
    border: none;
}

/* ─── Hero / Header Cards ─── */
QFrame#dashboardHero {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1e221c, stop:1 #222620);
    border: 1px solid #30372c;
    border-radius: 14px;
}
QFrame#dashboardHero:hover { border-color: #3a4236; }

/* ─── Metric Cards ─── */
QFrame#dashboardMetricCard,
QFrame#dashboardGaugesCard,
QFrame#cardFrame,
QFrame.card {
    background: #1e221c;
    border: 1px solid #30372c;
    border-radius: 14px;
}
QFrame#dashboardMetricCard:hover,
QFrame#dashboardGaugesCard:hover,
QFrame#cardFrame:hover,
QFrame.card:hover {
    background: #252a23;
    border-color: #6f7e5d;
}

/* ─── Charts & History Panels ─── */
QFrame#chartsPanel,
QFrame#historyPanel {
    background: #161916;
    border: 1px solid #30372c;
    border-radius: 14px;
}
QFrame#chartsPanel:hover,
QFrame#historyPanel:hover { border-color: #3a4236; }

/* ─── Dashboard Labels ─── */
QLabel#dashboardTitle {
    color: #e8e3d7;
    font-size: 17px;
    font-weight: 700;
}
QLabel#dashboardSubtitle {
    color: #969890;
    font-size: 11px;
}
QLabel#dashboardState {
    background: #252a23;
    color: #a5b98a;
    border: 1px solid #30372c;
    border-radius: 14px;
    padding: 6px 14px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.6px;
}
QLabel#panelTitle {
    color: #d8d0be;
    font-weight: 700;
}

/* ─── Air Quality Banner ─── */
QFrame#airBanner {
    background: #161916;
    border: 1px solid #30372c;
    border-radius: 12px;
}
QLabel#airBannerTitle { color: #d8d0be; font-weight: 700; }
QLabel[airChip="true"] {
    background: #1e221c;
    color: #c8c7be;
    border: 1px solid #30372c;
    border-radius: 10px;
    padding: 5px 12px;
    font-size: 11px;
}
QLabel[airChip="true"]:hover { border-color: #6f7e5d; color: #f2f0e8; }
QLabel#airPhase { color: #969890; font-size: 9px; font-weight: 700; letter-spacing: 1px; }

/* ─── Pestañas Principales (Fiel a Imagen 3) ─── */
QTabWidget::pane {
    background: #141714;
    border: 1px solid #30372c;
    border-radius: 14px;
    top: -1px;
}
QTabBar::tab {
    background: #252a23;
    color: #d8d0be;
    border: 1px solid #30372c;
    border-bottom: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    padding: 10px 24px;
    margin-right: 6px;
    font-size: 12px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: #d8d0be;
    color: #141714;
    border: 1px solid #bfb7a5;
    border-bottom: none;
    font-weight: 700;
}
QTabBar::tab:hover:!selected {
    background: #30372c;
    color: #e8e3d7;
}

/* ─── Botones Superiores Pill Shape ─── */
QPushButton {
    background: #d8d0be;
    color: #141714;
    border: 1px solid #bfb7a5;
    border-radius: 14px;
    padding: 7px 16px;
    font-weight: 600;
    font-size: 11.5px;
}
QPushButton:hover {
    background: #e8e3d7;
    border-color: #6f7e5d;
    color: #141714;
}
QPushButton:pressed {
    background: #bfb7a5;
}
QPushButton:disabled {
    background: #252a23;
    color: #6a6e66;
    border-color: #30372c;
}
QPushButton#subtleButton {
    background: #1e221c;
    color: #c8c7be;
    border: 1px solid #30372c;
    border-radius: 10px;
    padding: 5px 12px;
}
QPushButton#primaryButton {
    background: #6f7e5d;
    border-color: #82936b;
    color: #f2f0e8;
}
QPushButton#primaryButton:hover {
    background: #82936b;
}
QPushButton#dangerButton {
    background: #5c2e2e;
    border-color: #c45c5c;
    color: #f2e8e8;
}

/* ─── Controles de Formulario ─── */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #161916;
    color: #f2f0e8;
    border: 1px solid #30372c;
    border-radius: 10px;
    padding: 8px 12px;
    selection-background-color: #6f7e5d;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #82936b;
}
QComboBox QAbstractItemView {
    background: #1e221c;
    color: #f2f0e8;
    selection-background-color: #6f7e5d;
    selection-color: #fff;
    border: 1px solid #30372c;
}

/* ─── Tablas ─── */
QTableWidget {
    background: #141714;
    color: #f2f0e8;
    border: none;
    gridline-color: #252a23;
    alternate-background-color: #161916;
}
QTableWidget::item {
    padding: 7px;
    border-bottom: 1px solid #222620;
}
QTableWidget::item:selected {
    background: #30372c;
    color: #f2f0e8;
}
QHeaderView::section {
    background: #1e221c;
    color: #d8d0be;
    padding: 8px;
    font-weight: 700;
    font-size: 11px;
    border: none;
    border-bottom: 2px solid #30372c;
}

/* ─── Texto & Consolas ─── */
QTextEdit {
    background: #141714;
    color: #f2f0e8;
    border: 1px solid #30372c;
    border-radius: 12px;
    padding: 12px;
    selection-background-color: #6f7e5d;
}
QTextEdit#systemLog {
    background: #111411;
    border-color: #252a23;
    color: #969890;
    font-family: "JetBrains Mono", "Consolas", "Fira Code", monospace;
    font-size: 11px;
}

/* ─── Scrollbars ─── */
QScrollBar:vertical {
    background: transparent;
    width: 7px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #30372c;
    min-height: 30px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover { background: #6f7e5d; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { border: none; background: none; }
QScrollBar:horizontal {
    background: transparent;
    height: 7px;
}
QScrollBar::handle:horizontal {
    background: #30372c;
    min-width: 30px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover { background: #6f7e5d; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { border: none; background: none; }

/* ─── Tooltips ─── */
QToolTip {
    background: #252a23;
    color: #f2f0e8;
    border: 1px solid #3a4236;
    border-radius: 8px;
    padding: 6px 10px;
}

/* ─── Dialogs ─── */
QDialog { background: #161916; color: #f2f0e8; }
QMessageBox { background: #161916; }
QMessageBox QLabel { color: #f2f0e8; }

/* ─── Splitters ─── */
QSplitter::handle {
    background: #30372c;
    border-radius: 3px;
}
QSplitter::handle:hover { background: #6f7e5d; }

/* ─── Group Boxes ─── */
QGroupBox {
    background: #1e221c;
    border: 1px solid #30372c;
    border-radius: 12px;
    margin-top: 10px;
    padding-top: 16px;
    font-weight: 700;
    color: #d8d0be;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}
