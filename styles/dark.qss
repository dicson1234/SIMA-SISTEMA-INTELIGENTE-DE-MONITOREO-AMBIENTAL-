/*
 * SIMA — Sistema Inteligente de Monitoreo Ambiental
 * Hoja de Estilos — Modo Oscuro Botanical Dark (dark.qss)
 *
 * Paleta Botanical Dark:
 *   - Fondo Base:     #0b100d (Carbón Forestal)
 *   - Superficie:     #111a14 (Bosque Profundo)
 *   - Tarjetas:       #162019 (Hojarasca)
 *   - Bordes:         #1e3025 (Musgo)
 *   - Acento Primario:#4ade80 (Verde Hoja)
 *   - Acento Sec:     #a3e635 (Lima)
 *   - Éxito:          #4ade80 (Menta Brillante)
 *   - Advertencia:    #fbbf24 (Ámbar)
 *   - Alerta:         #ef4444 (Rojo)
 *   - Texto:          #d1fae5 (Verde Claro)
 *   - Texto Dim:      #6b8f78 (Gris Verde)
 */

/* =====================================================================
   ESTILOS GENERALES — FONDO CARBÓN FORESTAL
   ===================================================================== */

QMainWindow {
    background-color: #0b100d;
}

QWidget {
    color: #d1fae5;
    font-family: "Segoe UI", "Inter", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QFrame#cardFrame, QFrame.card {
    background-color: #111a14;
    border: 1px solid #1e3025;
    border-radius: 10px;
}

QFrame#cardFrame:hover, QFrame.card:hover {
    border: 1px solid #2d5a3a;
}

QFrame#plotContainer, QFrame#tableContainer {
    background-color: #111a14;
    border: 1px solid #1e3025;
    border-radius: 10px;
}

QFrame#futureCard {
    background-color: #0d1410;
    border: 1px dashed #1e3025;
    border-radius: 8px;
}

/* =====================================================================
   BARRA DE ESTADO — BOTANICAL DARK
   ===================================================================== */

QStatusBar {
    background-color: #0b100d;
    border-top: 1px solid #1e3025;
    color: #6b8f78;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

/* =====================================================================
   TOOLTIPS — BOTANICAL GLASS
   ===================================================================== */

QToolTip {
    background-color: #162019;
    color: #d1fae5;
    border: 1px solid #2d5a3a;
    border-radius: 6px;
    padding: 6px 10px;
}

/* =====================================================================
   BOTONES — BOTANICAL PILL
   ===================================================================== */

QPushButton {
    background-color: #162019;
    border: 1px solid #1e3025;
    border-radius: 6px;
    color: #d1fae5;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #233b2a;
    border-color: #4ade80;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #2d5a3a;
    border-color: #4ade80;
}

QPushButton:disabled {
    background-color: #0d1410;
    border-color: #1e3025;

    color: #4c4780;
}

/* Botón de Acción Principal — Verde Menta Pastel */
QPushButton#primaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #059669, stop:1 #10b981);
    border-color: #10b981;
    color: #ffffff;
    border-radius: 8px;
}

QPushButton#primaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #047857, stop:1 #059669);
    border-color: #059669;
}

QPushButton#primaryButton:pressed {
    background-color: #065f46;
    border-color: #047857;
}

/* Botón de Peligro — Rojo Carmesí Pastel */
QPushButton#dangerButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #dc2626, stop:1 #f87171);
    border-color: #f87171;
    color: #ffffff;
    border-radius: 8px;
}

QPushButton#dangerButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #b91c1c, stop:1 #dc2626);
    border-color: #dc2626;
}

QPushButton#dangerButton:pressed {
    background-color: #991b1b;
    border-color: #b91c1c;
}

/* =====================================================================
   CONTROLES DE FORMULARIO — SUPERFICIE ÍNDIGO
   ===================================================================== */

QLineEdit, QComboBox, QSpinBox {
    background-color: #0f0d1a;
    border: 1px solid #312e81;
    border-radius: 8px;
    padding: 8px 14px;
    color: #e2e8f0;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #7c3aed;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #312e81;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: #0f0d1a;
    border: 1px solid #4338ca;
    selection-background-color: #4338ca;
    selection-color: #ede9fe;
    color: #e2e8f0;
    padding: 4px;
    border-radius: 6px;
}

QLabel#titleLabel {
    font-size: 18px;
    font-weight: bold;
    color: #f8fafc;
}

QLabel#subtitleLabel {
    font-size: 12px;
    color: #a5b4fc;
}

/* =====================================================================
   TABLA DE MEDICIONES — VIDRIO ÍNDIGO
   ===================================================================== */

QTableWidget {
    background-color: #0f0d1a;
    border: none;
    gridline-color: #1e1b4b;
    border-radius: 8px;
}

QTableWidget::item {
    padding: 7px;
    border-bottom: 1px solid #1e1b4b;
}

QTableWidget::item:selected {
    background-color: #312e81;
    color: #ede9fe;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1e1b4b, stop:1 #0f0d1a);
    color: #a5b4fc;
    padding: 8px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #4338ca;
}

/* =====================================================================
   SCROLLBARS — SUAVE ÍNDIGO
   ===================================================================== */

QScrollBar:vertical {
    background-color: #0f0d1a;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #312e81;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4338ca;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: #0f0d1a;
    height: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #312e81;
    min-width: 24px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4338ca;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* =====================================================================
   PESTAÑAS — BOTANICAL DARK LUXURY
   ===================================================================== */

QTabWidget::pane {
    border: 1px solid #1c2e21;
    background-color: #0b120c;
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background-color: #121d15;
    border: 1px solid #1c2e21;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    color: #8fa895;
    padding: 10px 22px;
    font-weight: 600;
    font-size: 13px;
    margin-right: 6px;
}

QTabBar::tab:selected {
    background-color: #1a2e20;
    color: #4ade80;
    border-top: 3px solid #4ade80;
    border-bottom: none;
}

QTabBar::tab:hover:!selected {
    background-color: #16261b;
    color: #d1fae5;
}


/* =====================================================================
   DIÁLOGOS — VIDRIO ÍNDIGO
   ===================================================================== */

QDialog {
    background-color: #0f0d1a;
    border: 1px solid #1e1b4b;
}

QDialogButtonBox > QPushButton {
    min-width: 80px;
}

/* =====================================================================
   MENSAJES (QMessageBox) — ÍNDIGO SUAVE
   ===================================================================== */

QMessageBox {
    background-color: #0f0d1a;
}

QMessageBox QLabel {
    color: #e2e8f0;
}

/* =====================================================================
   TEXT EDIT — PANTALLA TERMINAL
   ===================================================================== */

QTextEdit {
    background-color: #070b14;
    border: 1px solid #1e1b4b;
    color: #e2e8f0;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: #4338ca;
}

/* =====================================================================
   SPLITTER — MANIJA ÍNDIGO
   ===================================================================== */

QSplitter::handle {
    background-color: #1e1b4b;
    border-radius: 3px;
}

QSplitter::handle:hover {
    background-color: #4338ca;
}
